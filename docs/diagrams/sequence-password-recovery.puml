@startuml
title Password Recovery Using a Recovery Code

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220

actor "User\n(unauthenticated)" as User
participant "Browser" as Browser
participant "RecoveryLoginController" as Controller
participant "RecoveryLoginService" as Service
participant "RecoveryCodeUtil" as CodeUtil
participant "UserRepository" as UserRepo
participant "BCryptPasswordEncoder" as BCrypt
participant "CredentialGeneratorService" as CredGen
participant "AuditLogRepository" as AuditRepo
database "MySQL" as DB

== Form Display ==

User -> Browser : Click "Forgot password?"
Browser -> Controller : GET /login/recovery
Controller --> Browser : Recovery form\n(email, recoveryCode, newPassword, confirmPassword)
Browser --> User : Form page

== Form Submission ==

User -> Browser : Fill in the form
Browser -> Controller : POST /login/recovery\n(email, recoveryCode, newPassword,\nconfirmPassword, CSRF token)

Controller -> Controller : Jakarta Bean Validation

alt Form validation errors (empty fields, password format)
  Controller --> Browser : Re-display form\nwith error messages
  Browser --> User : Form with errors

else Form valid
  Controller -> Controller : Compare newPassword == confirmPassword

  alt Passwords do not match
    Controller --> Browser : Form with error:\n"Passwords do not match"
    Browser --> User : Form with error

  else Passwords match
    Controller -> Service : resetPasswordWithRecoveryCode(\nemail, recoveryCode, newPassword)

    Service -> CodeUtil : normalizeInput(recoveryCode)
    note right : Remove dashes,\nspaces, convert to uppercase
    CodeUtil --> Service : normalized code (16 characters)

    Service -> UserRepo : findByEmail(email)
    UserRepo -> DB : SELECT * FROM users\nWHERE email = ?
    DB --> UserRepo : result

    alt User not found
      Service --> Controller : Optional.empty()
      Controller --> Browser : Form with message:\n"Unable to reset password.\nPlease check your email and recovery code."
      Browser --> User : Generic error message

    else User found
      Service -> Service : Check user.isActive()

      alt Account inactive
        Service --> Controller : Optional.empty()
        Controller --> Browser : Same generic error message
        Browser --> User : Generic error message

      else Account active
        Service -> BCrypt : matches(normalizedCode,\nuser.recoveryCodeHash)

        alt Recovery code invalid
          BCrypt --> Service : false
          Service --> Controller : Optional.empty()
          Controller --> Browser : Same generic error message
          Browser --> User : Generic error message

        else Recovery code valid
          BCrypt --> Service : true

          Service -> CredGen : generateRecoveryCode()
          CredGen --> Service : new recovery code (16-char Base32)

          Service -> BCrypt : encode(newPassword)
          BCrypt --> Service : new passwordHash
          Service -> BCrypt : encode(newRecoveryCode)
          BCrypt --> Service : new recoveryCodeHash

          Service -> UserRepo : save(user)\n[passwordHash + recoveryCodeHash updated]
          UserRepo -> DB : UPDATE users SET\npassword_hash = ?,\nrecovery_code_hash = ?\nWHERE id = ?
          DB --> UserRepo : OK

          Service -> AuditRepo : save(AuditLog)
          AuditRepo -> DB : INSERT INTO audit_logs\n(message = "Password reset via\nrecovery code: <email>")
          DB --> AuditRepo : OK

          Service --> Controller : Optional.of(newRecoveryCode)

          == POST-Redirect-GET ==

          Controller -> Controller : session.setAttribute(\n"recoveryLoginNewCode",\nformatForDisplay(newRecoveryCode))
          Controller --> Browser : HTTP 302 Redirect\n/login/recovery/success
          Browser -> Controller : GET /login/recovery/success

          Controller -> Controller : session.getAttribute("recoveryLoginNewCode")
          Controller -> Controller : session.removeAttribute("recoveryLoginNewCode")
          Controller --> Browser : Page with new recovery code\n+ Cache-Control: no-store\n+ Pragma: no-cache
          Browser --> User : One-time display\nof new recovery code

          == Page Refresh After Display ==

          User -> Browser : Refresh page (F5)
          Browser -> Controller : GET /login/recovery/success
          Controller -> Controller : session.getAttribute("recoveryLoginNewCode")
          note right : Value = null\n(removed after first display)
          Controller --> Browser : HTTP 302 Redirect /login
          Browser --> User : Login page
        end
      end
    end
  end
end

note over Controller, Service
  In all error cases the response
  is identical — it does not reveal
  whether the email exists,
  whether the code is wrong,
  or whether the account is inactive.
end note

@enduml
