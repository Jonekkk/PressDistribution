# MySQL Configuration
MYSQL_DATABASE=press_distribution
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=press_user
MYSQL_PASSWORD=press_password

# Spring Boot DataSource (only override if needed)
# Default values are in application.yaml
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/press_distribution?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=press_user
SPRING_DATASOURCE_PASSWORD=press_password

APP_BOOTSTRAP_ADMIN_FULL_NAME=Jan Kowalski
APP_BOOTSTRAP_ADMIN_EMAIL=twoj-email@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=my_secret_password

APP_SEED_ENABLED=true